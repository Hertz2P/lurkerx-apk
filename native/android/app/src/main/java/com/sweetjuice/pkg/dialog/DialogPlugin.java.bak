package com.sweetjuice.pkg.dialog;

import android.app.AlertDialog;
import android.content.Context;
import android.util.Log;
import android.view.ViewGroup;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;
import com.google.android.material.card.MaterialCardView;
import com.sweetjuice.app.SweetJuiceApplication;
import com.sweetjuice.plugin.SweetJuicePlugin;
import org.json.JSONException;
import org.json.JSONObject;
import sweetjuice.Sweetjuice;

public class DialogPlugin implements SweetJuicePlugin {

    private static final String TAG = "DialogPlugin";
    private Context mContext;

    @Override
    public String getDomain() { return "dialog"; }

    @Override
    public void onAttach(Context context) {
        this.mContext = context;
    }

    @Override
    public String handleAction(String action, String jsonArgsPayload) {
        try {
            if ("dialog:showAlert".equals(action)) {
                return showAlert(new JSONObject(jsonArgsPayload));
            }
            if ("dialog:showDialog".equals(action)) {
                return showDialog(new JSONObject(jsonArgsPayload));
            }
            return new JSONObject().put("error", "Unknown action").toString();
        } catch (JSONException e) {
            return errorJson(e.getMessage());
        }
    }

    private String showAlert(JSONObject args) {
        AppCompatActivity activity = getActiveActivity();
        if (activity == null) {
            return errorJson("No active activity");
        }

        String title = args.optString("title", "");
        String message = args.optString("message", "");
        String buttonText = args.optString("buttonText", "OK");

        activity.runOnUiThread(() -> {
            new AlertDialog.Builder(activity)
                .setTitle(title)
                .setMessage(message)
                .setPositiveButton(buttonText, (dialog, which) -> {
                    try {
                        JSONObject payload = new JSONObject();
                        payload.put("action", "dialog:showAlert");
                        payload.put("button", buttonText);
                        Sweetjuice.handleNativeAction("dialog:dismissed", "[" + payload.toString() + "]");
                    } catch (JSONException e) {
                        Log.e(TAG, "Failed to send dialog:dismissed", e);
                    }
                })
                .setCancelable(false)
                .show();
        });

        return okJson("shown");
    }

    private String showDialog(JSONObject args) {
        AppCompatActivity activity = getActiveActivity();
        if (activity == null) {
            return errorJson("No active activity");
        }

        String title = args.optString("title", "");
        String message = args.optString("message", "");
        String buttonText = args.optString("buttonText", "OK");

        activity.runOnUiThread(() -> {
            new AlertDialog.Builder(activity)
                .setTitle(title)
                .setMessage(message)
                .setPositiveButton(buttonText, (dialog, which) -> {
                    try {
                        JSONObject payload = new JSONObject();
                        payload.put("action", "dialog:showDialog");
                        payload.put("button", buttonText);
                        Sweetjuice.handleNativeAction("dialog:dismissed", "[" + payload.toString() + "]");
                    } catch (JSONException e) {
                        Log.e(TAG, "Failed to send dialog:dismissed", e);
                    }
                })
                .setCancelable(false)
                .show();
        });

        return okJson("shown");
    }

    private AppCompatActivity getActiveActivity() {
        SweetJuiceApplication app = null;
        if (mContext.getApplicationContext() instanceof SweetJuiceApplication) {
            app = (SweetJuiceApplication) mContext.getApplicationContext();
        }
        if (app != null) {
            return app.getActiveActivity();
        }
        return null;
    }

    private String okJson(String status) {
        try {
            return new JSONObject().put("status", status).toString();
        } catch (JSONException e) {
            return "{\"status\":\"" + status + "\"}";
        }
    }

    private String errorJson(String message) {
        try {
            return new JSONObject().put("error", message).toString();
        } catch (JSONException e) {
            return "{\"error\":\"" + message + "\"}";
        }
    }

    @Override public void onRequestPermissionsResult(int rc, String[] p, int[] g) {}
    @Override public void onActivityResult(int r, int rc, android.content.Intent d) {}
    @Override public void onNewIntent(android.content.Intent intent) {}
}

